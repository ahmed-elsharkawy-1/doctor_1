<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_TIMEZONE" value="Africa/Cairo"/>
        <env name="APP_LOCALE" value="ar"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- force: the suite wipes its database, so it must never be able to
             inherit DB_* from the shell or .env and point at a real one.
             Use phpunit.mysql.xml for a deliberate MySQL run. -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value=""/>
        <!-- force: a local .env may pin the verification code and lift the
             sending caps so the flow can be walked by hand. The suite tests
             those caps, so it always runs on the shipped values. -->
        <env name="CLINIC_SELF_BOOKING_REQUIRE_OTP" value="true" force="true"/>
        <!-- force: a local .env may select a real provider to walk the flow
             by hand. The suite must never send a real SMS or WhatsApp. -->
        <env name="CLINIC_OTP_DRIVER" value="log" force="true"/>
        <env name="CLINIC_MESSAGING_DRIVER" value="log" force="true"/>
        <env name="CLINIC_OTP_FIXED_CODE" value="" force="true"/>
        <env name="CLINIC_OTP_RESEND_COOLDOWN" value="60" force="true"/>
        <env name="CLINIC_OTP_MAX_PER_PHONE_HOUR" value="3" force="true"/>
        <env name="CLINIC_OTP_MAX_PER_IP_HOUR" value="10" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
