APP_NAME="Doctor 1"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://elayadah.com
APP_HOST=elayadah.com
APP_HOST_WWW=www.elayadah.com
APP_HOST_LEGACY=doctor1.srv1362420.hstgr.cloud

APP_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=doctor_1
DB_USERNAME=doctor_1
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax


FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

API_DOCS_ENABLED=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

CLINIC_DEFAULT_TIMEZONE=Africa/Cairo
CLINIC_DEFAULT_COUNTRY=EG

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

CLINIC_AVATAR_EXTENSION=png

# WhatsApp Cloud API. Stays on the log driver until the credentials below are
# filled in; switch to cloud_api only once they are.
CLINIC_MESSAGING_DRIVER=log
WHATSAPP_SYSTEM_USER_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
# Delivery receipts. Without the app secret the webhook refuses every callback,
# because an unverifiable receipt is worse than none.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Patient self-booking. Switch to cloud_api once Meta approves an
# AUTHENTICATION-category template; until then the code goes to the log and
# the public booking page stays off per clinic.
CLINIC_OTP_DRIVER=log
# CLINIC_OTP_FIXED_CODE must never be set here. A fixed verification code
# means anybody can book using anybody's number; the app throws if it finds
# one in production.

# Real-time slot updates (Phase 5). Leave as `log` and the whole app
# still works — the patient page falls back to refreshing on its own.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# Temporary: lets the `log` OTP driver run on a production host so the booking
# flow can be walked before an authentication template exists. Codes stay
# random — read them from the log. Unset it when the test is done.
# CLINIC_OTP_ALLOW_LOG_IN_PRODUCTION=true
# And this one lets CLINIC_OTP_FIXED_CODE work there too. Only safe while a
# deployment has no real patients: a code everyone knows lets anyone verify a
# number they do not own. Unset both before real patients arrive.
# CLINIC_OTP_ALLOW_FIXED_IN_PRODUCTION=true
